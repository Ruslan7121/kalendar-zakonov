{
  "name": "kalendar-zakonov",
  "private": true,
  "description": "Календарь законов: заседания, голосования и акты органов власти по официальным источникам",
  "scripts": {
    "build": "bash web/build.sh",
    "serve": "python3 -m http.server 8000 --directory web/dist",
    "test": "bash tests/run_all.sh",
    "typecheck": "node pipeline/merge/split_data.mjs --check >/dev/null && tsc -p tsconfig.json",
    "usage": "CLAUDE_CONFIG_DIR=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\" npx --yes ccusage@20.0.51 daily",
    "peek": "python3 pipeline/tools/peek.py",
    "lint": "eslint .",
    "lint:py": "ruff check . && ruff format --check .",
    "format": "prettier --write \"pipeline/**/*.mjs\" \"tests/js/*.mjs\" \"web/*.mjs\" \"web/*.ts\" \"web/*.tsx\" \"bot/*.mjs\" \"src/ui/*.tsx\" eslint.config.mjs",
    "format:check": "prettier --check \"pipeline/**/*.mjs\" \"tests/js/*.mjs\" \"web/*.mjs\" \"web/*.ts\" \"web/*.tsx\" \"bot/*.mjs\" \"src/ui/*.tsx\" eslint.config.mjs",
    "check:style": "npm run lint && npm run format:check && npm run lint:py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
