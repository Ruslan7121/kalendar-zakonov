    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": { "grok/canvas": ["web/grok-canvas.tsx"] }
  },
  "files": ["src/canvas.tsx", "web/gdx.ts", "web/grok-canvas.tsx"]
}
